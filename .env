### Network
NETWORK=mynetwork # make sure this network exists in docker, also change this in de docker-compose file under networks:

### Database
POSTGRES_DB=postgres_db
POSTGRES_USER=admin
POSTGRES_PASSWORD='VerySecretPasword'
DB_HOST=postgres
DB_PORT=5432

### Pgadmin
PGADMIN_DEFAULT_EMAIL=user@domain.com
PGADMIN_DEFAULT_PASSWORD='SecretPasword'
PGAMDIN_HOST=pgadmin
PGADMIN_PORT=8080

### Flask
FLASK_HOST=flask
FLASK_ENV=production
FLASK_DEBUG=0
FLASK_PORT=5000
API_KEY=v1/myApiKey

### Cron 
CRON_HOST=cron-c

### Node
NODE_ENV=production 

### React
REACT_HOST=react-dev
REACT_DEV_PORT=5173

### Reverse Proxy
REVERSE_PROXY_HOST=reverse-proxy
REVERSE_PROXY_PORT=80

### Jupyter
JUPYTER_HOST=jupyter-server
JUPYTER_PORT=8888